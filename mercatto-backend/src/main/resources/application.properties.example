# ================================================================
# MERCATTO BACKEND — application.properties.example
# Copia este archivo a application.properties y ajusta tus credenciales
# ================================================================

# ── Servidor ─────────────────────────────────────────────────────
server.port=${PORT:8085}
spring.main.allow-bean-definition-overriding=true

# ── Base de Datos PostgreSQL / Supabase ──────────────────────────
spring.datasource.url=${SPRING_DATASOURCE_URL:jdbc:postgresql://localhost:5432/postgres?sslmode=require}
spring.datasource.username=${SPRING_DATASOURCE_USERNAME:postgres}
spring.datasource.password=${SUPABASE_DB_PASSWORD:tu_password_aqui}
spring.datasource.driver-class-name=org.postgresql.Driver

# ── JPA / Hibernate ───────────────────────────────────────────────
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.PostgreSQLDialect
spring.jpa.properties.hibernate.format_sql=true
spring.jackson.serialization.fail-on-empty-beans=false

# ── Seguridad y JWT ───────────────────────────────────────────────
jwt.secret=${JWT_SECRET:genera_una_clave_segura_de_al_menos_256_bits_aqui}
jwt.expiration=86400000
jwt.refresh-expiration=604800000
app.cookie.secure=${APP_COOKIE_SECURE:false}

# ── Google OAuth ──────────────────────────────────────────────────
google.client-id=${GOOGLE_CLIENT_ID:tu_google_client_id.apps.googleusercontent.com}

# ── Stripe (Opcional Internacional) ───────────────────────────────
stripe.secret-key=${STRIPE_SECRET_KEY:sk_test_placeholder}
stripe.webhook-secret=${STRIPE_WEBHOOK_SECRET:whsec_placeholder}
stripe.currency=cop

# ── Wompi Pasarela Bancolombia (Colombia) ──────────────────────────
wompi.public-key=${WOMPI_PUBLIC_KEY:pub_test_Q5yDA9xoKdePzhSGeVe9KvxXQKIO5Ade}
wompi.private-key=${WOMPI_PRIVATE_KEY:prv_test_V0P7fI9L8YnO6R4W2M1K3J5H7G9F1D3S}
wompi.integrity-secret=${WOMPI_INTEGRITY_SECRET:test_integrity_456789abcdefghijklmnopqrstuv}
wompi.currency=COP

# ── Supabase Storage ───────────────────────────────────────────────
supabase.url=${SUPABASE_URL:https://cirxekyibynidhbnffll.supabase.co}
supabase.key=${SUPABASE_SERVICE_ROLE_KEY:}
supabase.bucket=${SUPABASE_BUCKET:Mercatto}

# ── Servidor de Correo SMTP ───────────────────────────────────────
spring.mail.host=${SPRING_MAIL_HOST:${MAIL_HOST:smtp.gmail.com}}
spring.mail.port=${SPRING_MAIL_PORT:${MAIL_PORT:587}}
spring.mail.username=${SPRING_MAIL_USERNAME:${MAIL_USERNAME:tu_correo@gmail.com}}
spring.mail.password=${SPRING_MAIL_PASSWORD:${MAIL_PASSWORD:tu_app_password_de_google}}
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true
spring.mail.properties.mail.smtp.starttls.required=true
spring.mail.properties.mail.smtp.ssl.trust=*
spring.mail.properties.mail.smtp.ssl.protocols=TLSv1.2 TLSv1.3
spring.mail.properties.mail.smtp.connectiontimeout=7000
spring.mail.properties.mail.smtp.timeout=7000
spring.mail.properties.mail.smtp.writetimeout=7000

# Proveedores de correo alternativos sobre HTTPS (puerto 443) para servidores como Render Free Tier
# que bloquean puertos SMTP salientes (25, 465, 587).
email.resend.api-key=${RESEND_API_KEY:}
email.resend.from=${RESEND_FROM:Mercatto <onboarding@resend.dev>}
email.brevo.api-key=${BREVO_API_KEY:}
email.brevo.from=${BREVO_FROM:tu_correo@gmail.com}

# ── Subida de Archivos ────────────────────────────────────────────
spring.servlet.multipart.max-file-size=2MB
spring.servlet.multipart.max-request-size=50MB

# ── CORS ──────────────────────────────────────────────────────────
app.cors.allowed-origins=${APP_CORS_ALLOWED_ORIGINS:http://localhost:5173,http://localhost:3000,https://mercatto-ashy.vercel.app,https://mercatto-dusky.vercel.app}
