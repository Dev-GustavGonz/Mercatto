{
  "name": "Mercatto AI Agent Assistant",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "mercatto-chat",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "e1a90c12-32cb-4654-8e12-37801844e101",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        220,
        300
      ],
      "webhookId": "mercatto-chat"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.body.message }}",
        "options": {
          "systemMessage": "Eres MercattoBot, el asesor virtual de Mercatto Colombia.\n\nTu misión es orientar con compras seguras, métodos de pago (Wompi, PSE, Nequi, Contra Entrega), planes para vendedores (comisiones desde el 2%), categorías y envíos a toda Colombia.\n\nDirectrices de tono y estilo:\n- Tono minimalista, profesional, sobrio y conciso. NO uses emojis ruidosos o exagerados.\n- MULTI-IDIOMA: Si el usuario escribe en inglés o el parámetro idioma es 'en', responde 100% en inglés. Si es en español, responde en español.\n- Usa viñetas limpias y negritas."
        }
      },
      "id": "b34e8f19-72a1-4d1a-8219-94711314a202",
      "name": "AI Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [
        480,
        300
      ]
    },
    {
      "parameters": {
        "modelName": "models/gemini-2.0-flash",
        "options": {
          "temperature": 0.7
        }
      },
      "id": "c5f21d30-4b11-4829-9e45-d8654a11b303",
      "name": "Google Gemini Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1,
      "position": [
        460,
        520
      ]
    },
    {
      "parameters": {
        "sessionIdType": "customKey",
        "sessionKey": "={{ $('Webhook Trigger').item.json.body.sessionId || 'default' }}"
      },
      "id": "a98d3c44-59b8-4c12-9c12-87123910c404",
      "name": "Window Buffer Memory",
      "type": "@n8n/n8n-nodes-langchain.memoryBufferWindow",
      "typeVersion": 1.3,
      "position": [
        580,
        520
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"reply\": {{ JSON.stringify($json.output) }}\n}",
        "options": {}
      },
      "id": "f87e1a22-90ab-41c3-88cd-58190284e505",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        840,
        300
      ]
    }
  ],
  "pinData": {},
